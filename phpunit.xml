<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnDeprecation="true"
         failOnPhpunitDeprecation="true"
         cacheDirectory=".phpunit.cache"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_URL" value="http://localhost"/>
        <env name="APP_LOCALE" value="en"/>
        <env name="APP_FALLBACK_LOCALE" value="en"/>
        <env name="APP_FAKER_LOCALE" value="en_US"/>
        <env name="APP_PREVIOUS_KEYS" value=""/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_URL" value=""/>
        <env name="DB_SSLMODE" value="prefer"/>
        <env name="DB_DATABASE" value="laravel"/>
        <env name="DB_USERNAME" value="laravel"/>
        <env name="DB_PASSWORD" value="secret"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="LOG_CHANNEL" value="null"/>
        <env name="RATE_LIMIT_READ" value="120"/>
        <env name="RATE_LIMIT_WRITE" value="30"/>
        <env name="SANCTUM_EXPIRATION" value="1440"/>
        <env name="SANCTUM_TOKEN_PREFIX" value=""/>
    </php>
</phpunit>
